# Cadena de conexión de la base de datos de Neon (producción / desarrollo).
DATABASE_URL=
# Cadena de una base de datos aparte, solo para las pruebas (se vacía en cada corrida).
# Las usan `npm test` y `npm run e2e` (Playwright pone PULSO_E2E=1 y el servidor local
# exige esta variable). `npm run dev:api` usa siempre DATABASE_URL y nunca esta.
PULSO_TEST_DATABASE_URL=
# Gmail y contraseña de aplicación para enviar el código de recuperación
CORREO_USUARIO=
CORREO_CLAVE=
